# Copie para .env  (o .env fica fora do git)

# Onde a APLICACAO aponta. Comente esta linha para cair no container local — o
# `server/db.js` tem o loopback como padrao, e e por essa ausencia que o
# `docker compose up -d && npm run dev` funciona sem configurar nada.
# Em producao, o usuario `readWrite` escopado ao banco. Nunca o `atlasAdmin`.
MONGODB_URI=mongodb://127.0.0.1:27017

MONGODB_DB=virtual_bookshelf
PORT=3000

# --- so para `scripts/db.mjs` --------------------------------------------
# Credencial de OPERACAO, com `dbAdmin` no banco da aplicacao. Aplicar o
# validador de schema e `collMod`, que `readWrite` nao inclui — por isso sao
# dois usuarios, e por isso a aplicacao nunca ve esta string.
MONGODB_ADMIN_URI=

# Origem da migracao. O default ja e este; existe para poder apontar para outro
# lugar sem editar o script.
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
