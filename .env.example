# Copie para .env  (o .env fica fora do git)

# Onde a APLICACAO aponta. Comente esta linha para cair no container local — o
# `server/db.js` tem o loopback como padrao, e e por essa ausencia que o
# `docker compose up -d && npm run dev` funciona sem configurar nada.
# Em producao, o usuario `readWrite` escopado ao banco. Nunca o `atlasAdmin`.
MONGODB_URI=mongodb://127.0.0.1:27017

MONGODB_DB=virtual_bookshelf
PORT=3000

# --- login com Google -----------------------------------------------------
# "OAuth client ID" do tipo Web application, no Google Cloud Console. Registrar
# la, em "Authorized redirect URIs", exatamente `<BASE_URL>/auth/google/callback`
# (em dev: http://localhost:5173/auth/google/callback; para testar o build,
# http://localhost:3000/auth/google/callback). O Google NAO aceita IP privado
# (192.168.x.x): login no celular so via deploy ou tunel https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Onde o site e servido — e para onde o Google volta. Em dev e o Vite. Sem barra
# final. Se comecar com https, os cookies ganham `Secure` sozinhos.
BASE_URL=http://localhost:5173

# O unico e-mail que entra sem convite, e o que vira admin (quem convida os
# outros pelo proprio app). Sem esta linha vale o padrao do codigo (`env.js`).
ADMIN_EMAIL=

# --- so para `scripts/db.mjs` --------------------------------------------
# Credencial de OPERACAO, com `dbAdmin` no banco da aplicacao. Aplicar o
# validador de schema e `collMod`, que `readWrite` nao inclui — por isso sao
# dois usuarios, e por isso a aplicacao nunca ve esta string.
MONGODB_ADMIN_URI=

# Origem da migracao. O default ja e este; existe para poder apontar para outro
# lugar sem editar o script.
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
